# -------------------------------------------------------------
# Tulasi AI - Production Environment Variables Template
# -------------------------------------------------------------

# ==========================================
# 1. Frontend Variables (Vercel)
# ==========================================
NEXT_PUBLIC_API_URL=https://tulasi-ai-soda.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://tulasi-ai-soda.onrender.com
NEXTAUTH_URL=https://tulasiai.in
NEXTAUTH_SECRET=generate_a_long_random_string_for_production

# (Optional) Google OAuth integration for NextAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# 2. Backend Variables (Render)
# ==========================================
# Google Gemini API Key
GOOGLE_API_KEY=AIzaSy...

# Secret key for JWT Token encoding
SECRET_KEY=generate_another_long_random_string

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://user:password@host.render.com/dbname

# Stripe Secret Key (for monetization)
STRIPE_SECRET_KEY=sk_test_...

# Port (Render auto-binds to this)
PORT=10000
